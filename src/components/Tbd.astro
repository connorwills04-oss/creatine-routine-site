---
/**
 * <Tbd>…</Tbd> or <Tbd value="[ship date]" />
 * Bracketed unknowns render in <span class="tbd">. A filled-in value renders as plain text.
 */
interface Props { value?: string }
const { value } = Astro.props;
const text = value ?? '';
const unknown = text.trim() === '' || /^\[[^\]]+\]$/.test(text.trim());
---
{unknown ? <span class="tbd">{text}<slot /></span> : text}
