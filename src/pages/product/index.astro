---
import Base from '../../layouts/Base.astro';
import Headline from '../../components/Headline.astro';
import Label from '../../components/Label.astro';
import Button from '../../components/Button.astro';
import Canister from '../../components/Canister.astro';
import PhotoPlaceholder from '../../components/PhotoPlaceholder.astro';
import Tbd from '../../components/Tbd.astro';
import { site, preordersOpen } from '../../config/site';
const { am, pm } = site.formulas;
const names = (f: typeof am | typeof pm) => f.ingredients.map((i) => i.name).join(', ');
---
<Base title="Starter kit" description="The starter kit: morning and evening single-serve sticks. Preorders are not open yet." tone="paper">
  <section class="section section--s pdp">
    <div class="wrap pdp__grid">
      <div class="pdp__gallery">
        <div class="pdp-scene" role="img" aria-label="The morning and evening canisters, open, side by side">
          <div class="pdp-scene__row">
            <Canister kind="am" open size="clamp(13px, 2.3vw, 28px)" />
            <Canister kind="pm" open size="clamp(13px, 2.3vw, 28px)" />
          </div>
          <span class="pdp-scene__base" aria-hidden="true"></span>
        </div>
        <div class="pdp-tiles">
          <div class="pdp-tiles__a"><PhotoPlaceholder ratio="4 / 5" caption="Photo: starter kit, open" /></div>
          <div class="pdp-tiles__b"><PhotoPlaceholder ratio="1" caption="Photo: morning stick in a glass" /></div>
          <div class="pdp-tiles__c"><PhotoPlaceholder ratio="3 / 4" caption="Photo: canisters on a desk" /></div>
          <div class="pdp-tiles__d"><PhotoPlaceholder ratio="16 / 10" caption="Photo: refill mailer" /></div>
        </div>
      </div>

      <div class="pdp__buy" data-pdp>
        <Label>Coming soon</Label>
        <Headline as="h1" size="h2">The starter <em>kit.</em></Headline>
        <p class="pdp__lede">Morning and evening sticks. Single-serve packs. Preorders aren't open yet.</p>
        <p class="pdp__price"><span class="pdp__price-label">Starter kit</span> <span class="pdp__price-value" data-shopify-price="kit"><Tbd>[price]</Tbd></span></p>
        <p class="pdp__formulas muted">
          <span><strong>AM</strong> {names(am)}</span>
          <span aria-hidden="true"> · </span>
          <span><strong>PM</strong> {names(pm)}</span>
        </p>

        <fieldset class="plan" disabled={!preordersOpen}>
          <legend class="label">Plan</legend>
          <label class="plan-card">
            <input type="radio" name="plan" value="subscribe" checked />
            <span class="plan-card__mark" aria-hidden="true"></span>
            <span class="plan-card__text">
              <span class="plan-card__name">Kit now, refills monthly <span class="plan-card__saving" data-plan-saving hidden></span></span>
              <span class="plan-card__sub">Not on sale yet. Skip or cancel: <Tbd value={site.unknowns.skipCancel} /></span>
            </span>
          </label>
          <label class="plan-card">
            <input type="radio" name="plan" value="once" />
            <span class="plan-card__mark" aria-hidden="true"></span>
            <span class="plan-card__text">
              <span class="plan-card__name">Kit only</span>
              <span class="plan-card__sub">One-time, when preorders open.</span>
            </span>
          </label>
        </fieldset>

        <div class="qty">
          <span class="label" id="qty-label">Quantity</span>
          <div class="qty__ctl" role="group" aria-labelledby="qty-label">
            <button type="button" data-qty-dec aria-label="Decrease quantity" disabled={!preordersOpen}>&minus;</button>
            <output data-qty-out aria-live="polite">1</output>
            <button type="button" data-qty-inc aria-label="Increase quantity" disabled={!preordersOpen}>+</button>
          </div>
        </div>

        <Button class="pdp__add" data-add-kit disabled={!preordersOpen}>{preordersOpen ? 'Add to cart' : "Preorders aren't open yet"}</Button>
        <p class="pdp__status" role="status" data-pdp-status>{preordersOpen ? '' : "Preorders aren't open yet. This site does not take payment."}</p>
        <p class="pdp__fine muted">
          Ship date: <Tbd value={site.unknowns.shipDate} />. Charge timing: <Tbd value={site.unknowns.chargeTiming} />.
        </p>
        <p class="pdp__fine muted">Sticks per pack: <Tbd value={site.unknowns.sticksPerPack} />. Packaging colors: <Tbd value={site.unknowns.packagingColors} />.</p>
        <p class="pdp__fine muted">Ships to <Tbd>{site.unknowns.shippingRegions}</Tbd>. Returns: <Tbd>{site.unknowns.returnPolicy}</Tbd>.</p>
      </div>
    </div>
  </section>

  <section class="section section--s pdp-details-sec">
    <div class="wrap pdp-details-wrap">
      <div class="pdp-details">
        <details open>
          <summary>What's in the kit</summary>
          <div class="pdp-details__body">
            <ul>
              <li>Two canisters, one morning and one evening</li>
              <li>Single-serve sticks</li>
              <li>Sticks per pack: <Tbd value={site.unknowns.sticksPerPack} /></li>
              <li>Packaging colors: <Tbd value={site.unknowns.packagingColors} /></li>
            </ul>
          </div>
        </details>
        <details>
          <summary>Morning stick</summary>
          <div class="pdp-details__body">
            <ul>
              {am.ingredients.map((i) => <li>{i.name} <Tbd value={i.dose} /></li>)}
            </ul>
            <p>Flavor: <Tbd value={am.flavor} /></p>
          </div>
        </details>
        <details>
          <summary>Evening stick</summary>
          <div class="pdp-details__body">
            <ul>
              {pm.ingredients.map((i) => <li>{i.name} <Tbd value={i.dose} /></li>)}
            </ul>
            <p>Flavor: <Tbd value={pm.flavor} /></p>
          </div>
        </details>
        <details>
          <summary>How to take it</summary>
          <div class="pdp-details__body">
            <p>Stir the morning stick into a glass of water and have it with breakfast.</p>
            <p>Stir the evening stick into water later in the day.</p>
          </div>
        </details>
        <details>
          <summary>Shipping and returns</summary>
          <div class="pdp-details__body">
            <p>Preorders aren't open yet. Ship date: <Tbd value={site.unknowns.shipDate} />. Ships to <Tbd value={site.unknowns.shippingRegions} />.</p>
            <p>Returns: <Tbd value={site.unknowns.returnPolicy} />.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- REVIEW: claims need sources + regulatory review -->
  <Fragment set:html={'<!-- REVIEW: claims need sources + regulatory review -->'} />
  <section class="section section--night section--l">
    <div class="wrap">
      <Headline as="h2" size="h2">What to <em>expect.</em></Headline>
      <div class="expect">
        <div class="expect__row">
          <h3 class="expect__label">Day one</h3>
          <p class="prose">A morning stick and an evening stick. That is the routine.</p>
        </div>
        <div class="expect__row">
          <h3 class="expect__label">The first weeks</h3>
          <p class="prose">Creatine monohydrate supports muscle when it is taken every day, over a few weeks. That is why the routine matters more than a single stick.</p>
        </div>
        <div class="expect__row">
          <h3 class="expect__label">After a month</h3>
          <p class="prose">Refills aren't on sale yet. Same routine when they are.</p>
        </div>
      </div>
      <p class="claim-disclaimer">{site.fdaDisclaimer}</p>
    </div>
  </section>

  <section class="section section--s">
    <div class="wrap refill">
      <div class="refill__copy">
        <Label>The refill</Label>
        <Headline as="h2" size="h3">Same routine. <em>New month.</em></Headline>
      </div>
      <div class="refill__buy">
        <p class="pdp__price"><span class="pdp__price-label">Refill</span> <span class="pdp__price-value" data-shopify-price="refill"><Tbd>[price]</Tbd></span></p>
        <Button variant="outline" data-add-refill disabled={!preordersOpen}>{preordersOpen ? 'Add the refill' : "Refills aren't open yet"}</Button>
      </div>
    </div>
  </section>
</Base>
<script>
  import '../../scripts/commerce/product';
</script>
<style is:global>
  .pdp__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .pdp__buy { position: sticky; top: 96px; display: grid; gap: 16px; align-content: start; }
  .pdp__lede { color: var(--ink-body); max-width: 44ch; }
  .pdp__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; font-weight: 500; }
  .pdp__price-label { color: var(--ink-2); font-size: var(--fs-small); }
  .pdp__price-value { font-size: 22px; font-weight: 600; }
  .pdp__formulas { font-size: var(--fs-small); display: flex; flex-wrap: wrap; gap: 0 6px; }
  .pdp__add { width: 100%; min-height: 52px; }
  .pdp__status { min-height: 0; font-size: var(--fs-small); color: var(--ink); }
  .pdp__status:not(:empty) { border-left: 4px solid var(--amber); padding-left: 10px; }
  .pdp__fine { font-size: var(--fs-small); }

  .pdp-scene { background: var(--photo); border-radius: var(--r-card); aspect-ratio: 6 / 5; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; padding: 0 5% 0; position: relative; overflow: hidden; }
  .pdp-scene__row { display: flex; align-items: flex-end; justify-content: center; gap: clamp(20px, 5vw, 72px); position: relative; z-index: 1; }
  .pdp-scene__base { display: block; width: 100%; height: 1px; background: #BDB8AD; margin-bottom: 14%; position: absolute; left: 0; bottom: 0; }
  .pdp-scene__row { margin-bottom: 14%; }
  .pdp-tiles { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 12px; margin-top: 12px; align-items: start; }
  .pdp-tiles__a { grid-column: 1 / span 7; }
  .pdp-tiles__b { grid-column: 8 / span 5; align-self: end; }
  .pdp-tiles__c { grid-column: 1 / span 4; }
  .pdp-tiles__d { grid-column: 5 / span 8; margin-top: 10%; }

  .plan { border: 0; margin: 0; padding: 0; display: grid; gap: 10px; min-width: 0; }
  .plan legend { padding: 0; margin-bottom: 8px; }
  .plan-card { position: relative; display: flex; gap: 14px; align-items: flex-start; padding: 16px; min-height: var(--tap); border: 2px solid var(--line-paper); border-radius: var(--r-card); background: var(--white); cursor: pointer; transition: border-color 120ms var(--ease-standard); }
  .plan-card:hover { border-color: #BDB8AD; }
  .plan-card:has(input:checked) { border-color: var(--night); }
  .plan-card:has(input:focus-visible) { outline: 2px solid var(--amber); outline-offset: 3px; }
  .plan-card input { position: absolute; opacity: 0; width: 100%; height: 100%; inset: 0; margin: 0; cursor: pointer; }
  .plan-card__mark { flex: none; width: 22px; height: 22px; margin-top: 1px; border: 2px solid var(--night); border-radius: 50%; display: grid; place-items: center; background: var(--white); }
  .plan-card:has(input:checked) .plan-card__mark { background: var(--amber); }
  .plan-card:has(input:checked) .plan-card__mark::after { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--night); }
  .plan-card__text { display: grid; gap: 4px; }
  .plan-card__name { font-weight: 600; }
  .plan-card__saving { font-weight: 500; font-size: var(--fs-small); margin-left: 6px; padding: 1px 6px; border: 1px solid var(--night); border-radius: var(--r-button); }
  .plan-card__saving[hidden] { display: none; }
  .plan-card__sub { color: var(--ink-2); font-size: var(--fs-small); }

  .qty { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .qty__ctl { display: inline-flex; align-items: center; border: 1px solid var(--night); border-radius: var(--r-button); background: var(--white); }
  .qty__ctl button { width: var(--tap); height: var(--tap); font-size: 20px; display: grid; place-items: center; }
  .qty__ctl button:hover:not(:disabled) { background: var(--photo); }
  .qty__ctl button:disabled { opacity: 0.4; cursor: not-allowed; }
  .qty__ctl output { min-width: 3ch; text-align: center; font-weight: 600; }

  .pdp-details-wrap { display: flex; justify-content: flex-start; }
  .pdp-details { width: 100%; max-width: 860px; border-top: 1px solid var(--line-paper); }
  .pdp-details details { border-bottom: 1px solid var(--line-paper); }
  .pdp-details summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 64px; font-family: var(--font-display); font-size: var(--fs-h3); letter-spacing: var(--track-display); }
  .pdp-details summary::-webkit-details-marker { display: none; }
  .pdp-details summary::after { content: '+'; font-family: var(--font-text); font-size: 24px; }
  .pdp-details details[open] summary::after { content: '\2212'; }
  .pdp-details__body { padding: 0 0 24px; display: grid; gap: 10px; color: var(--ink-body); max-width: 62ch; }
  .pdp-details__body ul { margin: 0; padding-left: 1.2em; display: grid; gap: 4px; }

  .expect { margin-top: clamp(40px, 6vw, 80px); border-top: 1px solid var(--line-night); }
  .expect__row { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 24px clamp(24px, 5vw, 80px); padding: 28px 0; border-bottom: 1px solid var(--line-night); }
  .expect__label { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-h3); letter-spacing: var(--track-display); line-height: 1; }

  .refill { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 24px 48px; border-top: 1px solid var(--line-paper); padding-top: 40px; }
  .refill__copy { display: grid; gap: 8px; }
  .refill__buy { display: grid; gap: 12px; justify-items: start; }

  @media (max-width: 900px) {
    .pdp__grid { grid-template-columns: minmax(0, 1fr); }
    .pdp__buy { position: static; }
    .expect__row { grid-template-columns: minmax(0, 1fr); gap: 8px; }
  }
</style>
